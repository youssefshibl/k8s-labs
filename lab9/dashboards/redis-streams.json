      "title": "Stream overview",
      "type": "row",
      "description": "High-level counters for the selected Redis stream (from XINFO STREAM / GROUPS)."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "unit": "short",
          "description": "redis_stream_length \u2014 Number of entries currently stored in the stream (XLEN / XINFO length). Grows with XADD; shrinks only if entries are trimmed/deleted (workers ACK but do not remove entries by default)."
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
